# Runs display.py at boot. install.sh fills in @USER@ and @DIR@ and enables it; to do it by hand, replace them and:
#   sudo cp scanner-display.service /etc/systemd/system/ && sudo systemctl enable --now scanner-display
[Unit]
Description=Scanner display (web page of what the Uniden scanner is receiving)
After=network.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 @DIR@/display.py 80
# Port 80 so the address is just http://<hostname>.local; this lets it bind there without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
